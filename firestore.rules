rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        : null;
    }
    function isSuperAdmin() { return role() == 'super_admin'; }
    function isReporting() { return role() == 'reporting'; }
    function isAdmin() { return isSuperAdmin() || isReporting(); }

    match /accounts/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false; // deletion via Cloud Function (GDPR flow)

      match /testators/{testatorId} {
        allow read: if isOwner(uid) || isSuperAdmin();
        allow write: if isOwner(uid);

        match /wills/{willId} {
          // Admins may NEVER write will content; owner may edit content
          // only while status == 'initiated'. Status/upload transitions
          // and the one-active-will rule are enforced by Cloud Functions
          // (Admin SDK bypasses rules; clients cannot fake them).
          allow read: if isOwner(uid) || isSuperAdmin();
          allow create: if isOwner(uid)
            && request.resource.data.status == 'initiated';
          allow update: if isOwner(uid)
            && resource.data.status == 'initiated'
            && request.resource.data.status in ['initiated', 'archived'];
          allow delete: if false; // archive, never delete (audit)
        }
      }
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if false; // managed by Cloud Function (super admin only)
    }

    match /auditLog/{id} {
      allow read: if isSuperAdmin();
      allow write: if false; // append-only via Cloud Functions
    }

    match /aggregates/{doc} {
      allow read: if isAdmin(); // anonymized dashboards for reporting role
      allow write: if false;
    }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if false; // super admin via Cloud Function
    }
  }
}
